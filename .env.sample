EMAIL_SENDER="<YOUR EMAIL>" # do not add gmail.com suffix
EMAIL_PASS="<YOUR PASSWD>"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
OPENAI_API_KEY='sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXxxx'
RABBITMQ_HOST='rabbitmq'
RABBITMQ_PORT='5672'
RABBITMQ_EMAIL_QUEUE='email'
GOOGLE_CLIENT_ID='855610430855-sn13uojmo3tsid2gth6ot2vp6eo5ftsn.apps.googleusercontent.com'
# Generate your own with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Keep it stable once set — changing it invalidates every logged-in session.
SECRET_KEY='this is a secret'
REDIRECT_URI='http://localhost:8080/api/v1/sign-in/callback'

# MySQL credentials — used by both the mysql container and the API's connection string
MYSQL_ROOT_PASSWORD='<YOUR DB ROOT PASSWORD>'
MYSQL_DATABASE='document_system'
MYSQL_USER='<YOUR DB USER>'
MYSQL_PASSWORD='<YOUR DB PASSWORD>'

# Both default to false when unset, so a server that forgets them gets the
# safe behaviour. Set them to true only for local development.
#   FLASK_DEBUG      - auto-reload and Flask's interactive debugger
#   SEED_DUMMY_DATA  - DROPS ALL TABLES on start, then inserts dummy data
FLASK_DEBUG=true
SEED_DUMMY_DATA=true

# Only for local http:// development. Leave unset (false) in production.
OAUTH_ALLOW_INSECURE_TRANSPORT=true

# Public hostname for TLS. 'localhost' locally, your real domain in production.
SITE_DOMAIN=localhost
